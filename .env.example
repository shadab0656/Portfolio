# Gmail SMTP (create an App Password: Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jokekarshadab@gmail.com
SMTP_PASS=your-16-character-app-password

# Where booking requests are delivered
BOOKING_TO=jokekarshadab@gmail.com

# Your live domain, used for canonical URLs, sitemap.xml and social previews (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: ownership codes from Google Search Console and Bing Webmaster Tools
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
